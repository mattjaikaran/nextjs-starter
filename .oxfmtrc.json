{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "printWidth": 80,
  "tabWidth": 2,
  "ignorePatterns": [
    "node_modules",
    ".next",
    "out",
    "build",
    "next-env.d.ts",
    "bun.lock",
    "openapi.json",
    "src/api/generated",
    "components/ui"
  ]
}
